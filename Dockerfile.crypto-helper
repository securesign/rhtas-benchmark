FROM golang:1.25 AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY crypto-helper.go .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /server crypto-helper.go

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /server /server
CMD ["/server"]
